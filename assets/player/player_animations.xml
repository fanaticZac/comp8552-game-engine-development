        <frame x="64" y="64" w="32" h="32" />
        <frame x="96" y="64" w="32" h="32" />
    </boost>

    <boost_and_gun>
        <frame x="0" y="96" w="32" h="32" />
        <frame x="32" y="96" w="32" h="32" />
        <frame x="64" y="96" w="32" h="32" />
        <frame x="96" y="96" w="32" h="32" />
